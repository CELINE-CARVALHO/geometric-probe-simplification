        "    split=\"train\"\n",
        ")\n",
        "\n",
        "sentences = []\n",
        "\n",
        "for item in dataset:\n",
        "    text = item[\"text\"].strip()\n",
        "\n",
        "    if 40 < len(text) < 200:\n",
        "        sentences.append(text)\n",
        "\n",
        "    if len(sentences) >= 50:\n",
        "        break\n",
        "\n",
        "print(f\"Loaded {len(sentences)} sentences\")\n",
        "print(f\"Example: {sentences[0]}\")"

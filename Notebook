      "source": [
        "### Step 2 — Attach hooks to capture activations\n",
        "\n",
        "A PyTorch hook is a function that fires automatically every time a layer runs during a forward pass.\n",
        "It captures the layer's input or output without modifying any weights.\n",
        "Think of it as a microphone placed inside the model."
      ],
      "metadata": {
        "id": "smqRPDljKHLU"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# Storage for all captured activations\n",
        "all_attn_weights = {l: [] for l in range(n_layers)}\n",
        "all_ffn_hidden   = {l: [] for l in range(n_layers)}\n",
        "all_ln_outputs   = {l: [] for l in range(n_layers)}\n",
        "all_layer_inputs = {l: [] for l in range(n_layers)}\n",
        "all_layer_outputs= {l: [] for l in range(n_layers)}\n",
        "\n",
        "hooks = []\n",
        "\n",
        "for layer_idx, layer in enumerate(model.h):\n",
        "\n",
        "    def make_ffn_hook(idx):\n",
        "        def hook(module, input, output):\n",
        "            all_ffn_hidden[idx].append(output.detach().cpu())\n",
        "        return hook\n",
        "\n",
        "    def make_ln_hook(idx):\n",
        "        def hook(module, input, output):\n",
        "            all_ln_outputs[idx].append(output.detach().cpu())\n",
        "        return hook\n",
        "\n",
        "    def make_input_hook(idx):\n",
        "        def hook(module, args):\n",
        "            if isinstance(args, tuple) and len(args) > 0 and args[0] is not None:\n",
        "                all_layer_inputs[idx].append(args[0].detach().cpu())\n",
        "        return hook\n",
        "\n",
        "    def make_output_hook(idx):\n",
        "        def hook(module, input, output):\n",
        "            if isinstance(output, tuple):\n",
        "                all_layer_outputs[idx].append(output[0].detach().cpu())\n",
        "            else:\n",
        "                all_layer_outputs[idx].append(output.detach().cpu())\n",
        "        return hook\n",
        "\n",
        "    hooks.append(layer.mlp.c_fc.register_forward_hook(make_ffn_hook(layer_idx)))\n",
        "    hooks.append(layer.ln_1.register_forward_hook(make_ln_hook(layer_idx)))\n",
        "    hooks.append(layer.register_forward_pre_hook(make_input_hook(layer_idx)))\n",
        "    hooks.append(layer.register_forward_hook(make_output_hook(layer_idx)))\n",
        "\n",
        "print(f\"Attached {len(hooks)} hooks across {n_layers} layers\")"
      ],
